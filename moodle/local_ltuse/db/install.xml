<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/ltuse/db" VERSION="20261004" COMMENT="XMLDB file for Moodle local/ltuse"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_ltuse_competency" COMMENT="The LTC competency framework, as declared in moodle/site/. Holds no user data. Rows are retired, never deleted.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Competency name, verbatim from competencies.yaml"/>
        <FIELD NAME="category" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Category key, verbatim from competencies.yaml"/>
        <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="1-based position across the whole framework"/>
        <FIELD NAME="retired" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="1 once the competency is no longer declared"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="name" UNIQUE="true" FIELDS="name"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_ltuse_course_comp" COMMENT="Which competencies each published course aims at, written by local_ltuse_set_course_competencies. Holds no user data.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="competencyid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
        <KEY NAME="competencyid" TYPE="foreign" FIELDS="competencyid" REFTABLE="local_ltuse_competency" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="courseid-competencyid" UNIQUE="true" FIELDS="courseid, competencyid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_ltuse_course_badge" COMMENT="Which badge is each published course's completion badge, written by local_ltuse_set_course_recognition (spec 013, R1). A badge has no idnumber, so this map is its identity. Holds no user data.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="badgeid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="imagehash" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="sha256 of the template image the badge's image was made from; core resizes it, so the stored files cannot be compared"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign-unique" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
        <KEY NAME="badgeid" TYPE="foreign-unique" FIELDS="badgeid" REFTABLE="badge" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="local_ltuse_mentor_contact" COMMENT="Message contacts local_ltuse made between a mentor and their learner (spec 003, research R5), so ending the relationship removes only those.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="mentorid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="user.id of the mentor"/>
        <FIELD NAME="learnerid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="user.id of the learner"/>
        <FIELD NAME="contactid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="message_contacts.id of the contact this plugin made, so only that one is ever removed"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="mentorid" TYPE="foreign" FIELDS="mentorid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="learnerid" TYPE="foreign" FIELDS="learnerid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="mentorlearner" UNIQUE="true" FIELDS="mentorid, learnerid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_ltuse_booking" COMMENT="Each office-hours booking's last notified time (spec 011, research R20), because core's calendar_event_updated carries no old time. One row per learner booking event.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="eventid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="event.id of the learner's SSstu: calendar event"/>
        <FIELD NAME="slotid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="scheduler_slots.id"/>
        <FIELD NAME="learnerid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="user.id of the learner who booked"/>
        <FIELD NAME="mentorid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="user.id of the slot's teacher when the booking was made"/>
        <FIELD NAME="timestart" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="the start as last notified"/>
        <FIELD NAME="timeduration" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="the length in seconds as last notified"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="learnerid" TYPE="foreign" FIELDS="learnerid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="eventid" UNIQUE="true" FIELDS="eventid"/>
        <INDEX NAME="slotid" UNIQUE="false" FIELDS="slotid"/>
        <INDEX NAME="mentorid" UNIQUE="false" FIELDS="mentorid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_ltuse_course_mentor" COMMENT="Course mentors who are not a learner's default mentor (spec 008, research R10): one-course mentors (learnerid set) and the mentors of a cohort in a course (cohortid set). Exactly one of learnerid, cohortid is non-zero, and neither is ever NULL, so the unique index holds. The foreign keys on courseid and mentorid are their indexes.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="course.id of an ltct:slug course, never ltct:officehours"/>
        <FIELD NAME="mentorid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="user.id of the course mentor, a member of ltct:mentors when recorded"/>
        <FIELD NAME="learnerid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="user.id of the learner for a one-course mentor; 0 when unused"/>
        <FIELD NAME="cohortid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="cohort.id for a cohort mentor; 0 when unused"/>
        <FIELD NAME="usermodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="user.id of who recorded it"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
        <KEY NAME="mentorid" TYPE="foreign" FIELDS="mentorid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="course-mentor-learner-cohort" UNIQUE="true" FIELDS="courseid, mentorid, learnerid, cohortid"/>
        <INDEX NAME="learnerid" UNIQUE="false" FIELDS="learnerid"/>
        <INDEX NAME="cohortid" UNIQUE="false" FIELDS="cohortid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
