# Python
__pycache__/
*.pyc
.venv/
.env

# OS
Thumbs.db
.DS_Store

# Per-contributor editor config (e.g. GitDoc auto-commit) — deliberately NOT shared,
# so opening this repo in VS Code never changes anyone else's commit behaviour
.vscode/

# MkDocs build output (generated by `mkdocs build`)
site/

# Export working files (regenerable from Notion; not the source of truth)
scripts/_export_manifest.json
scripts/_media_report.csv

# Notion archive exports (kept outside the repo)
.notion-vault/
*.tmp

# Video files — never commit; upload to Vimeo/CYPHER and link via external_links: in frontmatter
*.mp4
*.mov

# Generated CYPHER LMS paste artifacts (produced from module markdown by the
# cypher-html-conversion skill; the markdown is the source of truth)
*-cypher.html
*-cypher.bak

# Shared 4Cs section images — hosted on the LMS at /files/7780768/, not per-module assets
connect.png
content.png
challenge.png
change.png

# Session state written by scripts/session_hooks.py - the "where am I" tab each
# contributor pins in VS Code. Per-person and regenerated on every session start.
.claude/NOW.md

# Per-machine Claude Code permission grants -- references other, unrelated
# local projects and paths, so it is never shared config.
.claude/settings.local.json

# Per-course scratch staging used while producing cypher/ paste-ready HTML —
# regenerable working files, not source.
modules/*/Temp/

# Raw checking-assistant tool exports — not course content, may contain
# unpublished translation-project data.
**/checking-assistant-*.txt
